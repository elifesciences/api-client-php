{
    "name": "elife/api-client",
    "description": "eLife Sciences API client",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "eLife\\ApiClient\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spec\\eLife\\ApiClient\\": "./spec",
            "test\\eLife\\ApiClient\\": "./test"
        }
    },
    "require": {
        "php": "^8.3",
        "beberlei/assert": ">=2.2",
        "composer/package-versions-deprecated": "1.11.99.2",
        "crell/api-problem": "^3.6",
        "guzzlehttp/promises": "^2.0",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-message": "^1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "mtdowling/jmespath.php": "^2.0",
        "phpspec/phpspec": "^7.5",
        "phpspec/prophecy": "^1.10",
        "phpunit/phpunit": "^12.5.0",
        "psr/log": "^1.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "mtdowling/jmespath.php": "^2.0, to use the Result::search() method",
        "psr/log": "^1.0, to use the WarningCheckingHttpClient adapter",
        "monolog/monolog": "^1.0, to use the HttpMessageProcessor log processor"
    }
}
